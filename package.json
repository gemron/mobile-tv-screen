{
  "name": "mobile-tv-screen",
  "version": "1.2.0",
  "description": "Windows LAN media casting receiver with DLNA, basic AirPlay, TVBox compatibility and a browser remote",
  "author": "gemron",
  "repository": {
    "type": "git",
    "url": "https://github.com/gemron/mobile-tv-screen.git"
  },
  "homepage": "https://github.com/gemron/mobile-tv-screen#readme",
  "bugs": {
    "url": "https://github.com/gemron/mobile-tv-screen/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "build:win": "node scripts/build-win.js",
    "build:installer": "node scripts/build-installer.js",
    "test:release": "node scripts/smoke-release.js",
    "test:installer": "node scripts/smoke-installer.js",
    "test:buffering": "node tests/buffering-browser.js",
    "test:library:browser": "node tests/library-browser.js",
    "test:adfilter:browser": "node tests/ad-filter-browser.js",
    "test:source-browser": "node tests/source-browser.js",
    "test": "node tests/player.js && node tests/proxy.js && node tests/cache.js && node tests/library.js && node tests/html-sites.js && node tests/content-adapters.js && node tests/source-material.js && node tests/ad-filter.js && node tests/torrents.js && node tests/tvbox.js && node tests/verify.js"
  },
  "keywords": [
    "dlna",
    "upnp",
    "airplay",
    "cast",
    "screen-mirror",
    "mediarenderer"
  ],
  "license": "MIT",
  "dependencies": {
    "acorn": "^8.19.0",
    "bonjour-service": "^1.3.0",
    "bplist-parser": "^0.3.2",
    "cheerio": "^1.2.0",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "fast-xml-parser": "^5.12.1",
    "fs-chunk-store": "^5.0.1",
    "hls.js": "^1.5.18",
    "jsonc-parser": "^3.3.1",
    "mpegts.js": "^1.7.3",
    "multer": "^1.4.5-lts.1",
    "plist": "^3.1.0",
    "qrcode": "^1.5.4",
    "webtorrent": "^3.0.21",
    "ws": "^8.18.0"
  }
}
